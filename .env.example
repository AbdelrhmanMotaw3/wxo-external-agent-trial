# Public base URL after Render deploy (no trailing slash)
PUBLIC_URL=https://wxo-external-agent-trial.onrender.com

# Shared secret Orchestrate sends as Bearer or X-API-Key
AGENT_AUTH_TOKEN=change-me-trial-token

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Use-and-observability Agent IDs from AI Gateway > Agent directory
CHAT_AGENT_ID=
A2A_AGENT_ID=

# Observability-only Agent IDs (not available as collaborators)
CHAT_OBS_AGENT_ID=
A2A_OBS_AGENT_ID=

# watsonx Orchestrate trace export
TENANT_ID=
ENVIRONMENT_NAME=draft
OTEL_EXPORT_URL=https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces

# Auth for OTEL export — pick one style:
# IBM Cloud IAM
API_KEY=
TOKEN_URL=https://iam.cloud.ibm.com/identity/token
# MCSP v2
# AUTH_TYPE=MCSP_v2
# X_API_KEY=
# MCSP_V2_TOKEN_URL=
# Legacy header-only
# X_API_KEY=
