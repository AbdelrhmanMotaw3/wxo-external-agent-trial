# Public HTTPS origin of this service, with no trailing slash.
# Code Engine example: https://wxo-external-agent-trial.abc123.us-south.codeengine.appdomain.cloud
# Render example: https://wxo-external-agent-trial.onrender.com
PUBLIC_URL=https://wxo-external-agent-trial.example.codeengine.appdomain.cloud

# trial (default), customer_account, or network_service. One profile per application.
AGENT_PROFILE=trial

# Shared secret Orchestrate sends as Authorization: Bearer or X-API-Key.
# Supply this as an environment variable or Code Engine secret reference. Do not commit a real value.
AGENT_AUTH_TOKEN=replace-with-a-long-random-token

# OpenRouter. Supply OPENROUTER_API_KEY as an environment variable. Do not commit a real key.
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. Leave unset until basic chat and A2A calls succeed.
# Use-and-observability Agent IDs from AI Gateway > Agent directory
CHAT_AGENT_ID=
A2A_AGENT_ID=

# Observability-only Agent IDs (not available as collaborators)
CHAT_OBS_AGENT_ID=
A2A_OBS_AGENT_ID=

# Optional trace export. If OTEL_EXPORT_URL or TENANT_ID is empty, the service still answers and skips export.
TENANT_ID=
ENVIRONMENT_NAME=draft
OTEL_EXPORT_URL=https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces

# Auth for OTEL export — pick one style:
# IBM Cloud IAM
API_KEY=
TOKEN_URL=https://iam.cloud.ibm.com/identity/token
# MCSP v2
# AUTH_TYPE=MCSP_v2
# X_API_KEY=
# MCSP_V2_TOKEN_URL=
# Legacy header-only
# X_API_KEY=
